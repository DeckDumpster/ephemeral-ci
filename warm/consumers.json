{
  "dir": "/opt/ephemeral-ci/warm",
  "consumers": [
    {
      "name": "pokedumpster",
      "repo": "https://github.com/DeckDumpster/pokedumpster.git",
      "ref": "master",
      "lockfiles": ["Cargo.lock", "rust-toolchain.toml", "frontend/package-lock.json", "Containerfile"],
      "env": {"CARGO_TARGET_DIR": "$HOME/.cache/pkdump-builds"},
      "steps": [
        "bash deploy/runner-deps.sh",
        {"run": "cargo fetch --locked", "optional": true},
        {"run": "cargo test --workspace --no-run --locked", "optional": true},
        {"run": "podman build -f Containerfile -t localhost/ephemeral-ci-warm/pokedumpster:warm .", "optional": true},
        "npm ci --prefix frontend"
      ]
    },
    {
      "name": "dumpstar",
      "repo": "https://github.com/DeckDumpster/dumpstar.git",
      "ref": "main",
      "lockfiles": ["Cargo.lock", "rust-toolchain.toml", "frontend/package-lock.json", "Containerfile"],
      "env": {"CARGO_TARGET_DIR": "$HOME/.cache/dumpstar-builds"},
      "steps": [
        "bash deploy/runner-deps.sh",
        {"run": "cargo fetch --locked", "optional": true},
        {"run": "cargo test --workspace --no-run --locked", "optional": true},
        {"run": "podman build -f Containerfile -t localhost/ephemeral-ci-warm/dumpstar:warm .", "optional": true},
        "npm ci --prefix frontend"
      ]
    }
  ]
}
